# --- Postgres ---
POSTGRES_DB=jbclaims
POSTGRES_USER=jbclaims
POSTGRES_PASSWORD=changeme

# --- Backend secrets ---
JWT_SECRET=change-this-to-a-long-random-string

# --- Default superadmin, created on first startup if it doesn't exist yet ---
DEFAULT_SUPERADMIN_NAME=Super Admin
DEFAULT_SUPERADMIN_EMAIL=admin@example.com
DEFAULT_SUPERADMIN_MSISDN=254700000000
DEFAULT_SUPERADMIN_PASSWORD=ChangeMe123!

# Set to true to also seed a sample customer/policy/claims on first startup.
SEED_DEMO_DATA=true

# Comma-separated browser origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
