# Copy this file to .env and adjust values before running `docker compose up`.
# .env is read by docker-compose.yml both for variable substitution and,
# for portal-api, passed straight through into the container as env vars.

# --- Postgres ---
POSTGRES_DB=jbclaims
POSTGRES_USER=jbclaims
POSTGRES_PASSWORD=changeme

# --- Backend secrets ---
JWT_SECRET=change-this-to-a-long-random-string

# --- Default superadmin, created on first startup if it doesn't exist yet ---
DEFAULT_SUPERADMIN_NAME=Super Admin
DEFAULT_SUPERADMIN_EMAIL=admin@example.com
DEFAULT_SUPERADMIN_MSISDN=254700000000
DEFAULT_SUPERADMIN_PASSWORD=ChangeMe123!

# Set to true to also seed a sample customer/policy/claims on first startup.
SEED_DEMO_DATA=true

# --- Frontend ---
# Must be reachable from the browser (the client calls this directly), not
# from inside the docker network - so localhost, not the "portal-api" service name.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
