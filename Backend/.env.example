# Copy to .env for running the backend standalone (outside docker-compose),
# e.g. with `uvicorn main:app --reload` against a local Postgres instance.

POSTGRES_DB=jbclaims
POSTGRES_USER=jbclaims
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

JWT_SECRET=change-this-to-a-long-random-string

DEFAULT_SUPERADMIN_NAME=Super Admin
DEFAULT_SUPERADMIN_EMAIL=admin@example.com
DEFAULT_SUPERADMIN_MSISDN=254700000000
DEFAULT_SUPERADMIN_PASSWORD=ChangeMe123!

SEED_DEMO_DATA=true

# Optional: override the default /var/log/... path for local runs.
# PORTAL_API_LOG_FILE=./portal_api.log
